# Copie para .env para usar uma API real (o Expo lê o .env sozinho, em qualquer sistema).
# Sem esta variável, o app usa os dados de demonstração de src/mock/regioes.json.
# Use o IP do computador na rede Wi-Fi (não use localhost: o celular não enxerga o seu PC por esse nome).
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080
